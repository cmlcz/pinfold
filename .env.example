# Copy to .env and fill in. Run with: node --env-file=.env ...
# The key for the Repair Model, which pinfold uses only when a model is
# named, here or as repairModel in pinfold.json.
OPENROUTER_API_KEY=
# The OpenRouter model that proposes Repairs. Set, it switches the Repair
# Model on and wins over repairModel in pinfold.json.
PINFOLD_REPAIR_MODEL=openai/gpt-4o-mini
