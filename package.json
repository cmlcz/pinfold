{
  "name": "pinfold",
  "version": "0.0.0",
  "description": "A local MCP Gateway that turns an agent's one-off code into a Workflow you own and can re-run without an LLM.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pinfold": "src/packages/cli/bin.ts",
    "pinfold-gateway": "src/packages/gateway/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src",
    "check": "npm run typecheck && npm run lint && npm run lint:boundaries",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "esbuild": "^0.28.2",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
